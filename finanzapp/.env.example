# FinanzApp — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit real values. In Vercel, set these under Project → Settings → Environment Variables.

# ---- Database (Neon PostgreSQL) ----
# Runtime: POOLED connection (host contains "-pooler") — required for serverless.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Migrations / db push: DIRECT connection (same host WITHOUT "-pooler").
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Auth.js ----
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET="CHANGE_ME_GENERATE_A_REAL_SECRET"
# In Vercel set to your production URL, e.g. https://fin593.vercel.app
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# ---- SMTP (password reset OTP) ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="FinanzApp <noreply@finanzapp.ec>"

# ---- Admin seed (only used by `npm run db:seed`) ----
ADMIN_EMAIL="admin@finanzapp.ec"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
