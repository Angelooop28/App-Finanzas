// Prisma Schema — FinanzApp
// Modelo de datos para gestión financiera personal (Ecuador)
// PostgreSQL para producción

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection (-pooler) for runtime
  directUrl = env("DIRECT_URL")   // Neon direct connection for migrations
}

// ---- Auth.js Models ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- App Models ----

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  age           Int?
  city          String?
  currency      String    @default("USD")
  role          Role      @default(USER)
  status        UserStatus       @default(ACTIVE)
  plan          SubscriptionPlan @default(FREE)
  payFrequency  PayFrequency @default(MONTHLY)
  payrollCutoffDay Int?
  onboardingCompleted Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts             Account[]
  sessions             Session[]
  incomes              Income[]
  payrollDeductions    PayrollDeduction[]
  debts                Debt[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  savingsGoals         SavingsGoal[]
  alerts               Alert[]
  purchaseQueries      PurchaseQuery[]
  financialConfigs     FinancialConfig[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]
}

enum PayFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

model Income {
  id          String     @id @default(cuid())
  userId      String
  grossAmount Float
  netAmount   Float?
  isNetManual Boolean    @default(false)
  period      String
  type        IncomeType @default(SALARY)
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, period])
}

enum IncomeType {
  SALARY
  BONUS
  FREELANCE
  OTHER
}

model PayrollDeduction {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         DeductionType @default(OTHER)
  percentage   Float?
  fixedAmount  Float?
  isPercentage Boolean       @default(true)
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DeductionType {
  IESS
  IESS_LOAN
  TAX
  ADVANCE
  OTHER
}

model Debt {
  id                    String     @id @default(cuid())
  userId                String
  name                  String
  creditor              String?
  type                  DebtType   @default(OTHER)
  totalOwed             Float
  originalAmount        Float?
  monthlyPayment        Float
  interestRate          Float?
  nextDueDate           DateTime?
  remainingInstallments Int?
  manualPriority        Int?
  status                DebtStatus @default(ACTIVE)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId, status])
}

enum DebtType {
  CREDIT_CARD
  PERSONAL_LOAN
  MORTGAGE
  INFORMAL
  IESS_LOAN
  CAR_LOAN
  STUDENT_LOAN
  OTHER
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
  OVERDUE
  PAUSED
}

model DebtPayment {
  id          String      @id @default(cuid())
  debtId      String
  amount      Float
  paymentDate DateTime
  type        PaymentType @default(REGULAR)
  notes       String?
  createdAt   DateTime    @default(now())

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId, paymentDate])
}

enum PaymentType {
  REGULAR
  EXTRA
  MINIMUM
}

model ExpenseCategory {
  id       String       @id @default(cuid())
  userId   String
  name     String
  type     ExpenseType  @default(VARIABLE)
  icon     String?
  color    String?
  isSystem Boolean      @default(false)
  createdAt DateTime    @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([userId])
}

enum ExpenseType {
  FIXED
  VARIABLE
}

model Expense {
  id           String   @id @default(cuid())
  userId       String
  categoryId   String
  description  String?
  amount       Float
  date         DateTime
  isRecurring  Boolean  @default(false)
  recurringDay Int?
  period       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([userId, period])
  @@index([categoryId])
}

model SavingsGoal {
  id                  String       @id @default(cuid())
  userId              String
  name                String
  type                SavingsType  @default(CUSTOM)
  targetAmount        Float
  currentAmount       Float        @default(0)
  monthlyContribution Float?
  targetDate          DateTime?
  targetMonths        Int?
  status              SavingsStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SavingsType {
  EMERGENCY_FUND
  CUSTOM
}

enum SavingsStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

model Alert {
  id                String        @id @default(cuid())
  userId            String
  type              AlertType
  title             String
  message           String
  severity          AlertSeverity @default(INFO)
  isRead            Boolean       @default(false)
  triggerDate       DateTime
  relatedEntityId   String?
  relatedEntityType String?
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([triggerDate])
}

enum AlertType {
  DEBT_DUE
  OVERSPENDING
  OVERDUE
  SAVINGS_MILESTONE
  SYSTEM
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model PurchaseQuery {
  id             String          @id @default(cuid())
  userId         String
  description    String
  amount         Float
  recommendation Recommendation
  justification  String
  surplusAtTime  Float
  createdAt      DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Recommendation {
  YES
  NO
  CONDITIONAL
}

model FinancialConfig {
  id          String  @id @default(cuid())
  userId      String
  key         String
  value       Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ---- Password Reset (OTP) ----

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  code      String   // OTP de 6 dígitos, hasheado con bcrypt
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---- Audit Log ----

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // LOGIN, REGISTER, PASSWORD_RESET_REQUEST, PASSWORD_RESET_COMPLETE, ADMIN_ACTION
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
